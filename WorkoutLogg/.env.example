# Copy to `.env` (same folder as docker-compose.yml) and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_DB=workoutLogger
POSTGRES_USER=postgres
# Use a strong, unique password.
POSTGRES_PASSWORD=change_me

# --- Kafka ---
# Host/IP that external clients (e.g. the mobile app) use to reach the broker.
# Use "localhost" for local development.
KAFKA_EXTERNAL_HOST=localhost

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- API (HTTPS dev certificate) ---
CERT_PASSWORD=change_me

# --- JWT ---
# Long random string (>= 32 bytes) used to sign access tokens.
JWT_SIGNING_KEY=change_me_to_a_long_random_secret
