# Скопируйте в `.env` рядом с docker-compose.yml и заполните значения.
# Файл читают Compose и локальный API (Development + UseLocalhost=true).
# `.env` исключён из Git и не должен попадать в коммиты.

# --- PostgreSQL ---
POSTGRES_DB=workoutLogger
POSTGRES_USER=postgres
# Use a strong, unique password.
POSTGRES_PASSWORD=change_me

# --- Kafka ---
# Host/IP that external clients (e.g. the mobile app) use to reach the broker.
# Use "localhost" for local development.
KAFKA_EXTERNAL_HOST=localhost

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- API (HTTPS dev certificate) ---
CERT_PASSWORD=change_me

# --- JWT ---
# Случайный ключ (>= 32 байт) для подписи токенов.
# В локальном API JWT_SIGNING_KEY автоматически задаёт AuthConfiguration:Key.
JWT_SIGNING_KEY=change_me_to_a_long_random_secret
