    <Style x:Key="IconCloseAction" TargetType="Label" BasedOn="{StaticResource FitnessActionIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Close}" /></Style>
    <Style x:Key="IconMoreAction" TargetType="Label" BasedOn="{StaticResource FitnessActionIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.More}" /></Style>
    <Style x:Key="IconUpAction" TargetType="Label" BasedOn="{StaticResource FitnessActionIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Up}" /></Style>
    <Style x:Key="IconDownAction" TargetType="Label" BasedOn="{StaticResource FitnessActionIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Down}" /></Style>
