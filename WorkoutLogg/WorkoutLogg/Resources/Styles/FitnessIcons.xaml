        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="IconBackButton" TargetType="Button" BasedOn="{StaticResource FitnessIconButton}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Back}" /></Style>
    <Style x:Key="IconPreviousButton" TargetType="Button" BasedOn="{StaticResource FitnessIconButton}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Left}" /></Style>
    <Style x:Key="IconNextButton" TargetType="Button" BasedOn="{StaticResource FitnessIconButton}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Right}" /></Style>
</ResourceDictionary>
