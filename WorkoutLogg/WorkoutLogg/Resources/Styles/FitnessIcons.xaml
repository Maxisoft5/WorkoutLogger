    <Style x:Key="IconKey" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Key}" /></Style>
    <Style x:Key="IconLock" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Lock}" /></Style>
    <Style x:Key="IconShield" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Shield}" /></Style>
    <Style x:Key="IconSettings" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Settings}" /></Style>
    <Style x:Key="IconDocument" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Document}" /></Style>
    <Style x:Key="IconLegal" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Legal}" /></Style>
    <Style x:Key="IconLink" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Link}" /></Style>
