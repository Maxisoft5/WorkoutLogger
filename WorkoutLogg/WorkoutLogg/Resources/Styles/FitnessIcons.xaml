    <Style x:Key="IconProhibited" TargetType="Label" BasedOn="{StaticResource FitnessIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Prohibited}" /></Style>
    <Style x:Key="IconAddAction" TargetType="Label" BasedOn="{StaticResource FitnessActionIcon}"><Setter Property="Text" Value="{x:Static icons:FitnessIcons.Add}" /></Style>
