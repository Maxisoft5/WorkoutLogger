<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:vm="clr-namespace:WorkoutLogg.PageModels"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Purple header card -->
                <Border BackgroundColor="#7C3AED"
                        Padding="20,52,20,24"
                        StrokeShape="RoundRectangle 0,0,28,28"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="20">

                        <!-- Avatar + name -->
                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                            <Grid WidthRequest="84" HeightRequest="84" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChangeAvatarTapped" />
                                </Grid.GestureRecognizers>
                                <!-- Initials fallback -->
                                <Border BackgroundColor="#9333EA"
                                        HeightRequest="84"
                                        StrokeShape="Ellipse"
                                        StrokeThickness="0"
                                        WidthRequest="84"
                                        IsVisible="{Binding HasNoProfilePicture}">
                                    <Label FontAttributes="Bold"
                                           FontSize="28"
                                           HorizontalOptions="Center"
                                           Text="{Binding UserInitials}"
                                           TextColor="White"
                                           VerticalOptions="Center" />
                                </Border>
                                <!-- Profile photo -->
                                <Grid HeightRequest="84" WidthRequest="84"
                                      IsVisible="{Binding HasProfilePicture}">
                                    <Image Source="{Binding AvatarImageSource}"
                                           Aspect="AspectFill"
                                           HeightRequest="84"
                                           WidthRequest="84">
                                        <Image.Clip>
                                            <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42" />
                                        </Image.Clip>
                                    </Image>
                                    <Ellipse Stroke="#9333EA" StrokeThickness="2"
                                             HeightRequest="84" WidthRequest="84"
                                             Fill="Transparent" />
                                </Grid>
                            </Grid>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label FontAttributes="Bold"
                                       FontSize="22"
                                       Text="{Binding UserName}"
                                       TextColor="White" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label FontSize="13"
                                           Text="{Binding MemberSinceLabel}"
                                           TextColor="#DDD6FE" />
                                    <Border IsVisible="{Binding IsPremium}"
                                            BackgroundColor="#9333EA"
                                            Padding="8,3"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0">
                                        <Label FontAttributes="Bold"
                                               FontSize="11"
                                               Text="⭐ Premium"
                                               TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Body stats row -->
                        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="0">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label FontAttributes="Bold" FontSize="22" HorizontalOptions="Center"
                                       Text="{Binding WeightLabel}" TextColor="White" />
                                <Label FontSize="12" HorizontalOptions="Center" Text="{loc:Translate Profile_Weight}" TextColor="#DDD6FE" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" BackgroundColor="#9333EA" WidthRequest="1" />
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label FontAttributes="Bold" FontSize="22" HorizontalOptions="Center"
                                       Text="{Binding HeightLabel}" TextColor="White" />
                                <Label FontSize="12" HorizontalOptions="Center" Text="{loc:Translate Profile_Height}" TextColor="#DDD6FE" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="3" BackgroundColor="#9333EA" WidthRequest="1" />
                            <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                                <Label FontAttributes="Bold" FontSize="22" HorizontalOptions="Center"
                                       Text="{Binding BodyFatLabel}" TextColor="White" />
                                <Label FontSize="12" HorizontalOptions="Center" Text="{loc:Translate Profile_BodyFat}" TextColor="#DDD6FE" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Edit stats button -->
                        <Border BackgroundColor="#9333EA"
                                Padding="14,6"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Label FontAttributes="Bold"
                                   FontSize="12"
                                   Text="{loc:Translate Common_Edit}"
                                   TextColor="#DDD6FE">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditStatsTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditStatsTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Activity pills -->
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Border BackgroundColor="#9333EA" Padding="14,8" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="🔥" FontSize="14" VerticalOptions="Center" />
                                    <Label VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StreakLabel}" FontAttributes="Bold" TextColor="White" FontSize="13" />
                                                <Span Text=" " TextColor="White" FontSize="13" />
                                                <Span Text="{loc:Translate Common_DayStreak}" TextColor="#DDD6FE" FontSize="12" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="#9333EA" Padding="14,8" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="📓" FontSize="14" VerticalOptions="Center" />
                                    <Label VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TotalSessionsLabel}" FontAttributes="Bold" TextColor="White" FontSize="13" />
                                                <Span Text=" " TextColor="White" FontSize="13" />
                                                <Span Text="{loc:Translate Common_Sessions}" TextColor="#DDD6FE" FontSize="12" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Padding="20,20,20,12" Spacing="16">

                    <!-- Personal Records -->
                    <Border BackgroundColor="White" Padding="18,16" Stroke="#F3F4F6"
                            StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Profile_PersonalRecords}" TextColor="#111827" />

                            <CollectionView ItemsSource="{Binding PersonalRecords}"
                                            SelectionMode="None"
                                            HeightRequest="186">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="2"
                                                     HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PersonalRecordVM">
                                        <Border BackgroundColor="#F9FAFB" Padding="14,12"
                                                Stroke="#F3F4F6" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                            <VerticalStackLayout Spacing="3">
                                                <Label FontSize="12" Text="{Binding ExerciseName}"
                                                       TextColor="#9CA3AF" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label FontAttributes="Bold" FontSize="20"
                                                       Text="{Binding WeightLabel}" TextColor="{Binding ValueColor}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Achievements -->
                    <Border BackgroundColor="White" Padding="18,16" Stroke="#F3F4F6"
                            StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" FontAttributes="Bold" FontSize="16"
                                       Text="{loc:Translate Profile_Achievements}" TextColor="#111827" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="13"
                                       Text="{Binding UnlockedLabel}" TextColor="#7C3AED" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Achievements}"
                                            SelectionMode="None"
                                            HeightRequest="{Binding AchievementsGridHeight}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="2"
                                                     HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AchievementVM">
                                        <Border BackgroundColor="{Binding CardBg}"
                                                Padding="10,10"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="0"
                                                Opacity="{Binding Opacity}">
                                            <Grid ColumnDefinitions="78,*" ColumnSpacing="8"
                                                  RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                                <!-- Emoji circle -->
                                                <Border Grid.Column="0" Grid.RowSpan="3"
                                                        BackgroundColor="{Binding EmojiCircleColor}"
                                                        HeightRequest="78" WidthRequest="78"
                                                        StrokeShape="RoundRectangle 10"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start">
                                                    <Label FontSize="16"
                                                           HorizontalOptions="Center"
                                                           Text="{Binding Emoji}"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <!-- Title -->
                                                <Label Grid.Column="1" Grid.Row="0"
                                                       FontAttributes="Bold" FontSize="11"
                                                       Text="{Binding Title}"
                                                       TextColor="{Binding TitleColor}"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                <!-- Description -->
                                                <Label Grid.Column="1" Grid.Row="1"
                                                       FontSize="9"
                                                       Text="{Binding Description}"
                                                       TextColor="#9CA3AF"
                                                       LineBreakMode="WordWrap" MaxLines="2" />
                                                <!-- Progress -->
                                                <Label Grid.Column="1" Grid.Row="2"
                                                       FontSize="9" FontAttributes="Bold"
                                                       Text="{Binding ProgressText}"
                                                       TextColor="{Binding ProgressColor}"
                                                       IsVisible="{Binding HasProgress}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Settings -->
                    <Border BackgroundColor="White" Padding="4,8" Stroke="#F3F4F6"
                            StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout>
                            <!-- Premium row -->
                            <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPremiumTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="⭐" FontSize="16"
                                       VerticalOptions="Center" Margin="0,0,8,0" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label x:Name="PremiumRowTitle" FontSize="15" FontAttributes="Bold"
                                           Text="{loc:Translate Profile_GetPremium}"
                                           TextColor="#7C3AED" />
                                    <Label x:Name="PremiumRowSub" FontSize="11" TextColor="#9CA3AF"
                                           IsVisible="False" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" FontSize="18" Text="›" TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>
                            <BoxView BackgroundColor="#F3F4F6" HeightRequest="1" Margin="16,0" />
                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" FontSize="15" Text="{loc:Translate Profile_Language}" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontSize="18" Text="›" TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>
                            <BoxView BackgroundColor="#F3F4F6" HeightRequest="1" Margin="16,0" />
                            <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTrainersTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🏋️" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0" />
                                <Label Grid.Column="1" FontSize="15" Text="{loc:Translate Profile_FindTrainer}" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontSize="18" Text="›" TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>
                            <BoxView BackgroundColor="#F3F4F6" HeightRequest="1" Margin="16,0" />
                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStandardsTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" FontSize="15" Text="{loc:Translate Profile_Standards}" TextColor="#111827" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontSize="18" Text="›" TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>
                            <BoxView BackgroundColor="#F3F4F6" HeightRequest="1" Margin="16,0" />
                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" FontSize="15" Text="{loc:Translate Profile_Logout}" TextColor="#EF4444" VerticalOptions="Center" />
                                <Label Grid.Column="1" FontSize="18" Text="›" TextColor="#FCA5A5" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:MainTabBar Grid.Row="1" ActiveTab="Profile" />
        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
