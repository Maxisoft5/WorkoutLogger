<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.TrainersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:vm="clr-namespace:WorkoutLogg.PageModels"
    x:DataType="vm:TrainersPageModel"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#7C3AED"
                Padding="20,52,20,20"
                StrokeShape="RoundRectangle 0,0,28,28"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" BackgroundColor="#9333EA" Padding="10,8"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0"
                        VerticalOptions="Center">
                    <Label Text="←" FontSize="18" TextColor="White" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{loc:Translate Trainers_Title}"
                           FontAttributes="Bold" FontSize="20" TextColor="White" />
                    <Label Text="{loc:Translate Trainers_Subtitle}"
                           FontSize="12" TextColor="#DDD6FE" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

                <!-- Specialization filter chips -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Trainers_Filter_Specialization}"
                           FontAttributes="Bold" FontSize="13" TextColor="#6B7280" />
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="8">
                            <Border x:Name="ChipStrength" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipStrengthLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_Strength}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="Strength" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border x:Name="ChipWeightLoss" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipWeightLossLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_WeightLoss}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="WeightLoss" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border x:Name="ChipCrossfit" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipCrossfitLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_Crossfit}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="Crossfit" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border x:Name="ChipYoga" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipYogaLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_Yoga}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="Yoga" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border x:Name="ChipRehabilitation" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipRehabilitationLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_Rehabilitation}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="Rehabilitation" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border x:Name="ChipRunning" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                                <Label x:Name="ChipRunningLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Spec_Running}" TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecTapped" CommandParameter="Running" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Sort chips -->
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8">
                        <Border x:Name="SortMatch" BackgroundColor="#7C3AED" StrokeThickness="0" Padding="14,8" StrokeShape="RoundRectangle 20">
                            <Label x:Name="SortMatchLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Sort_Match}" TextColor="White">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSortTapped" CommandParameter="Match" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="SortPriceAsc" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                            <Label x:Name="SortPriceAscLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Sort_PriceAsc}" TextColor="#6B7280">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSortTapped" CommandParameter="PriceAsc" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="SortPriceDesc" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                            <Label x:Name="SortPriceDescLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Sort_PriceDesc}" TextColor="#6B7280">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSortTapped" CommandParameter="PriceDesc" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="SortNewest" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1.5" Padding="14,8" StrokeShape="RoundRectangle 20">
                            <Label x:Name="SortNewestLabel" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Trainers_Sort_Newest}" TextColor="#6B7280">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSortTapped" CommandParameter="Newest" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Recommended for you -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasRecommended}">
                    <Label Text="{loc:Translate Trainers_Recommended}"
                           FontAttributes="Bold" FontSize="18" TextColor="#111827" />
                    <CollectionView ItemsSource="{Binding Recommended}" HeightRequest="150">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrainerCardItem">
                                <Border BackgroundColor="White" Padding="16" WidthRequest="220"
                                        Stroke="#F3F4F6" StrokeThickness="1" StrokeShape="RoundRectangle 18">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTrainerTapped" CommandParameter="{Binding UserId}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" BackgroundColor="#EDE9FE" WidthRequest="40" HeightRequest="40"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                                <Label Text="{Binding Emoji}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="2" BackgroundColor="#F0FDF4" Padding="8,4"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                                <Label Text="{Binding MatchLabel}" FontAttributes="Bold" FontSize="11" TextColor="{Binding MatchColor}" />
                                            </Border>
                                        </Grid>
                                        <Label Grid.Row="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#111827" />
                                        <Label Grid.Row="2" Text="{Binding PriceLabel}" FontAttributes="Bold" FontSize="13" TextColor="#7C3AED" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- All trainers -->
                <Label Text="{loc:Translate Trainers_All}"
                       FontAttributes="Bold" FontSize="18" TextColor="#111827" />

                <CollectionView ItemsSource="{Binding Results}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrainerCardItem">
                            <Border BackgroundColor="White" Padding="16" Margin="0,0,0,10"
                                    Stroke="#F3F4F6" StrokeThickness="1" StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTrainerTapped" CommandParameter="{Binding UserId}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Avatar -->
                                    <Border Grid.Column="0" BackgroundColor="#EDE9FE" WidthRequest="52" HeightRequest="52"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 26" VerticalOptions="Start">
                                        <Label Text="{Binding Emoji}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="#111827" />
                                        <Label Text="{Binding SubLabel}" FontSize="12" TextColor="#9CA3AF" />
                                        <Label Text="{Binding About}" FontSize="12" TextColor="#6B7280" MaxLines="2" LineBreakMode="TailTruncation" IsVisible="{Binding HasAbout}" />
                                    </VerticalStackLayout>
                                    <!-- Match + price -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="6" VerticalOptions="Center">
                                        <Border BackgroundColor="#F0FDF4" Padding="8,4" StrokeThickness="0" StrokeShape="RoundRectangle 10" HorizontalOptions="End">
                                            <Label Text="{Binding MatchLabel}" FontAttributes="Bold" FontSize="11" TextColor="{Binding MatchColor}" />
                                        </Border>
                                        <Label Text="{Binding PriceLabel}" FontAttributes="Bold" FontSize="14" TextColor="#7C3AED" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="0,32" Spacing="10" HorizontalOptions="Center">
                    <Label FontSize="40" HorizontalOptions="Center" Text="🔍" />
                    <Label FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"
                           Text="{loc:Translate Trainers_Empty}" TextColor="#111827" />
                    <Label FontSize="14" HorizontalOptions="Center"
                           Text="{loc:Translate Trainers_EmptySubtitle}" TextColor="#9CA3AF" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
