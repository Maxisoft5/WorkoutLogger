<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.NewPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:fonts="clr-namespace:Fonts"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="28,52,28,40" Spacing="0">

        <!-- Back -->
        <HorizontalStackLayout Margin="0,0,0,36" Spacing="8">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                <Label Style="{StaticResource IconBackAction}" HorizontalOptions="Fill" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Fill" SemanticProperties.Description="{loc:Translate Common_Back}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label FontSize="15" Text="{loc:Translate Common_Back}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>

        <!-- Icon -->
        <Border
            Margin="0,0,0,28"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
            HeightRequest="100"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 22"
            StrokeThickness="0"
            WidthRequest="100">
            <Label Style="{StaticResource IconKey}" FontSize="40" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <!-- Title -->
        <Label FontAttributes="Bold" FontSize="26" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,8" Text="{loc:Translate NewPassword_Title}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
        <Label FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,36" Text="{loc:Translate NewPassword_Subtitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

        <!-- NEW PASSWORD -->
        <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate NewPassword_NewPasswordLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
        <Border Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
            <Grid ColumnDefinitions="*,48">
                <Entry x:Name="NewPasswordEntry" BackgroundColor="Transparent" FontSize="15" IsPassword="True" Margin="14,0,0,0" Placeholder="••••••••" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextChanged="OnPasswordTextChanged" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                <Grid Grid.Column="1" MinimumHeightRequest="48" WidthRequest="48" BackgroundColor="Transparent" SemanticProperties.Description="{loc:Translate Common_TogglePassword}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleNewPasswordVisibility" />
                    </Grid.GestureRecognizers>
                <Image x:Name="NewPasswordEyeImage" InputTransparent="True" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:FluentUI.eye_20_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Size="20"/>
                    </Image.Source>
                </Image>
                </Grid>
            </Grid>
        </Border>

        <!-- CONFIRM PASSWORD -->
        <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate NewPassword_ConfirmPasswordLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
        <Border Margin="0,0,0,18" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
            <Grid ColumnDefinitions="*,48">
                <Entry x:Name="ConfirmPasswordEntry" BackgroundColor="Transparent" FontSize="15" IsPassword="True" Margin="14,0,0,0" Placeholder="••••••••" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                <Grid Grid.Column="1" MinimumHeightRequest="48" WidthRequest="48" BackgroundColor="Transparent" SemanticProperties.Description="{loc:Translate Common_TogglePassword}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleConfirmPasswordVisibility" />
                    </Grid.GestureRecognizers>
                <Image x:Name="ConfirmPasswordEyeImage" InputTransparent="True" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:FluentUI.eye_20_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Size="20"/>
                    </Image.Source>
                </Image>
                </Grid>
            </Grid>
        </Border>

        <!-- PASSWORD STRENGTH -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,6" VerticalOptions="Center">
            <Label Grid.Column="0" CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Text="{loc:Translate NewPassword_PasswordStrength}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" VerticalOptions="Center" />
            <Label x:Name="StrengthLabel" Grid.Column="2" FontAttributes="Bold" FontSize="12" Text="" TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" VerticalOptions="Center" />
        </Grid>

        <!-- Strength bar -->
        <Grid ColumnDefinitions="*,4,*,4,*" Margin="0,0,0,28" HeightRequest="6">
            <BoxView x:Name="Bar0" Grid.Column="0" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" CornerRadius="3" />
            <BoxView x:Name="Bar1" Grid.Column="2" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" CornerRadius="3" />
            <BoxView x:Name="Bar2" Grid.Column="4" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" CornerRadius="3" />
        </Grid>

        <!-- Reset Password -->
            <Border StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button BackgroundColor="Transparent" Clicked="OnResetPasswordClicked" FontAttributes="Bold" FontSize="16" Text="{loc:Translate NewPassword_ResetPassword}" TextColor="White" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
