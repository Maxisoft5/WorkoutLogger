<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.OnboardingGoalsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Step indicator -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,52,0,32" Spacing="6">
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="28" Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,0" Spacing="0">

                <!-- Step label -->
                <Label CharacterSpacing="1" FontAttributes="Bold" FontSize="11" Margin="0,0,0,10" Text="{loc:Translate Onboarding_Step3}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                <Label FontAttributes="Bold" FontSize="28" Margin="0,0,0,8" Text="{loc:Translate Onboarding_GoalsTitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                <Label FontSize="14" Margin="0,0,0,28" Text="{loc:Translate Onboarding_GoalsSubtitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

                <!-- Goal: Lose Fat -->
                <Border x:Name="LoseFatBorder" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                        Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeWarningSoftLight}, Dark={StaticResource ThemeWarningSoftDark}}" HeightRequest="48"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconFire}" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalLoseFat}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Text="{loc:Translate Onboarding_GoalLoseFatSub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="FatGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text="" TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="LoseFat" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Goal: Build Muscle -->
                <Border x:Name="BuildMuscleBorder" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,14"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeWarningSoftLight}, Dark={StaticResource ThemeWarningSoftDark}}" HeightRequest="48"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconStrength}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalBuildMuscle}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="14" Text="{loc:Translate Onboarding_GoalBuildMuscleSub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="BuildMuscleGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text="" TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="BuildMuscle" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Goal: Improve Endurance -->
                <Border x:Name="EnduranceBorder" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBlueSoftLight}, Dark={StaticResource ThemeBlueSoftDark}}" HeightRequest="48" StrokeShape="RoundRectangle 12"
                                StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconCardio}" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeBlueLight}, Dark={StaticResource ThemeBlueDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalEndurance}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Text="{loc:Translate Onboarding_GoalEnduranceSub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="EnduranceGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text=""
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="Endurance" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Goal: Increase Strength -->
                <Border x:Name="StrengthBorder" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeWarningSoftLight}, Dark={StaticResource ThemeWarningSoftDark}}" HeightRequest="48"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconProgress}" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeWarningLight}, Dark={StaticResource ThemeWarningDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalStrength}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Text="{loc:Translate Onboarding_GoalStrengthSub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="StrengthCheckGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text=""
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="Strength" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Goal: Flexibility -->
                <Border x:Name="FlexibilityBorder" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemePinkSoftLight}, Dark={StaticResource ThemePinkSoftDark}}" HeightRequest="48"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconMobility}" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemePinkLight}, Dark={StaticResource ThemePinkDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalFlexibility}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Text="{loc:Translate Onboarding_GoalFlexibilitySub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="FlexibilityCheckGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text=""
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="Flexibility" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Goal: Stay Active -->
                <Border x:Name="StayActiveBorder" Margin="0,0,0,28" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeWarningSoftLight}, Dark={StaticResource ThemeWarningSoftDark}}" HeightRequest="48"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="48" VerticalOptions="Center">
                            <Label Style="{StaticResource IconTarget}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Onboarding_GoalStayActive}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" />
                            <Label FontSize="12" Text="{loc:Translate Onboarding_GoalStayActiveSub}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" HeightRequest="28"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center" WidthRequest="28">
                            <Label x:Name="StayActiveCheckGoal" Style="{StaticResource FitnessIcon}" FontSize="18" HorizontalOptions="Center" Text=""
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalTapped" CommandParameter="StayActive" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Workouts per week -->
                <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11"
                       Margin="4,0,0,14" Text="{loc:Translate Onboarding_WorkoutsPerWeek}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border x:Name="W1Border" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="W1Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="1" FontAttributes="Bold" FontSize="14" Text="1×" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    </Border>
                    <Border x:Name="W2Border" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="W2Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="2" FontAttributes="Bold" FontSize="14" Text="2×" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    </Border>
                    <Border x:Name="W3Border" Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="W3Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="3" FontAttributes="Bold" FontSize="14" Text="3×" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    </Border>
                    <Border x:Name="W4Border" Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                        <Button x:Name="W4Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="4" FontAttributes="Bold" FontSize="14" Text="4×" TextColor="White" />
                    </Border>
                    <Border x:Name="W5Border" Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="W5Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="5" FontAttributes="Bold" FontSize="14" Text="5×" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    </Border>
                    <Border x:Name="W6Border" Grid.Row="1" Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="W6Button" BackgroundColor="Transparent" Clicked="OnWorkoutFreqTapped" CommandParameter="6" FontAttributes="Bold" FontSize="14" Text="6×" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Finish Button -->
        <Border Grid.Row="2" Margin="28,16,28,40" StrokeShape="RoundRectangle 14" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Button BackgroundColor="Transparent" Clicked="OnFinishClicked" FontAttributes="Bold" FontSize="16" Text="{loc:Translate Common_Finish}" TextColor="White" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,12" />
        </Border>

    </Grid>
</ContentPage>
