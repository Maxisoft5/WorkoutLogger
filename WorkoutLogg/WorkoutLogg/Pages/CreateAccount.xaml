<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.CreateAccount"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:fonts="clr-namespace:Fonts"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,40" Spacing="0">

            <!-- App Icon -->
            <Border
                Margin="0,0,0,24"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                HeightRequest="100"
                WidthRequest="100">
                <Label Style="{StaticResource IconBrand}" FontSize="44" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Title -->
            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,6"
                Text="{loc:Translate Register_Title}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />

            <Label
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,32"
                Text="{loc:Translate Register_Subtitle}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

            <!-- FULL NAME -->
            <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Register_FullName}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
            <Border x:Name="FullNameBorder" Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                <Entry x:Name="FullNameEntry" BackgroundColor="Transparent" FontSize="15" Margin="14,0" Placeholder="Alex Petrov" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" ReturnType="Next" />
            </Border>
            <Label x:Name="FullNameError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- EMAIL -->
            <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Register_Email}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
            <Border x:Name="EmailBorder" Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                <Entry x:Name="EmailEntry" BackgroundColor="Transparent" FontSize="15" Keyboard="Email" Margin="14,0" Placeholder="alex@gmail.com" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" ReturnType="Next" />
            </Border>
            <Label x:Name="EmailError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- PASSWORD -->
            <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Register_Password}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
            <Border x:Name="PasswordBorder" Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                <Grid ColumnDefinitions="*,48">
                    <Entry x:Name="PasswordEntry" BackgroundColor="Transparent" FontSize="15" IsPassword="True" Margin="14,0,0,0" Placeholder="••••••••" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" ReturnType="Next" />
                    <Grid Grid.Column="1" BackgroundColor="Transparent" MinimumHeightRequest="48" WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                        </Grid.GestureRecognizers>
                        <Image x:Name="PasswordEyeImage" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.eye_20_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Size="20"/>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Grid>
            </Border>
            <Label x:Name="PasswordError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- CONFIRM PASSWORD -->
            <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Register_ConfirmPassword}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
            <Border x:Name="ConfirmPasswordBorder" Margin="0,0,0,20" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                <Grid ColumnDefinitions="*,48">
                    <Entry x:Name="ConfirmPasswordEntry" BackgroundColor="Transparent" FontSize="15" IsPassword="True" Margin="14,0,0,0" Placeholder="••••••••" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" ReturnType="Done" />
                    <Grid Grid.Column="1" BackgroundColor="Transparent" MinimumHeightRequest="48" WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleConfirmPasswordVisibility" />
                        </Grid.GestureRecognizers>
                        <Image x:Name="ConfirmPasswordEyeImage" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.eye_20_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Size="20"/>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Grid>
            </Border>
            <Label x:Name="ConfirmPasswordError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- Terms Checkbox -->
            <Grid
                Margin="0,0,0,28"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">

                <CheckBox
                    x:Name="TermsCheckBox"
                    Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                    VerticalOptions="Center"
                    CheckedChanged="OnTermsCheckedChanged" />

                <Label
                    Grid.Column="1"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center">

                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Translate Register_AgreeToThe}" />
                            <Span Text=" " />

                            <Span
                                Text="{loc:Translate Register_TermsOfService}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTermsTapped" />
                                </Span.GestureRecognizers>
                            </Span>

                            <Span Text=" " />
                            <Span Text="{loc:Translate Register_And}" />
                            <Span Text=" " />

                            <Span
                                Text="{loc:Translate Register_PrivacyPolicy}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <Label
                x:Name="TermsCheckBoxError"
                Margin="4,0,0,12"
                FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}"
                IsVisible="False" />

            <!-- Create Account Button -->
            <Border Margin="0,0,0,24" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="CreateAccountGradient1" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" Offset="0" />
                        <GradientStop x:Name="CreateAccountGradient2" Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button x:Name="CreateAccountButton" BackgroundColor="Transparent" Clicked="OnCreateAccountClicked"
                        IsEnabled="True"
                        FontAttributes="Bold" FontSize="16" Text="{loc:Translate Register_CreateAccount}" TextColor="White" />
            </Border>

            <!-- Sign In Link -->
            <Label FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{loc:Translate Register_AlreadyHaveAccount}" />
                        <Span Text=" " />
                        <Span FontAttributes="Bold" Text="{loc:Translate Login_SignIn}" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignInTapped" />
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
