<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.PasswordSuccess"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
    <VerticalStackLayout Padding="28,52,28,40" Spacing="0">

        <!-- Back -->
        <HorizontalStackLayout Margin="0,0,0,36" Spacing="8">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                <Label Style="{StaticResource IconBackAction}" HorizontalOptions="Fill" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Fill" SemanticProperties.Description="{loc:Translate Common_Back}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label FontSize="15" Text="{loc:Translate Common_Back}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>

        <!-- Green check icon -->
        <Border
            Margin="0,0,0,28"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 22"
            StrokeThickness="0">
            <Label Style="{StaticResource IconCheckCircle}" FontSize="40" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <!-- Title -->
        <Label FontAttributes="Bold" FontSize="26" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,8" Text="{loc:Translate PasswordSuccess_Title}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
        <Label FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,36" Text="{loc:Translate PasswordSuccess_Subtitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

        <!-- Success banner -->
        <Border
            Margin="0,0,0,32"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSuccessSoftLight}, Dark={StaticResource ThemeSuccessSoftDark}}"
            Padding="20,18"
            Stroke="{AppThemeBinding Light={StaticResource ThemeSuccessSoftLight}, Dark={StaticResource ThemeSuccessSoftDark}}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1.5">
            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate PasswordSuccess_Banner}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" />
        </Border>

        <!-- Back to Sign In -->
        <Border StrokeShape="RoundRectangle 14" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Button BackgroundColor="Transparent" Clicked="OnBackToSignInClicked" FontAttributes="Bold" FontSize="16" Text="{loc:Translate PasswordSuccess_BackToSignIn}" TextColor="White" />
        </Border>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
