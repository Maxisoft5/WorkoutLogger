<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.MyBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:vm="clr-namespace:WorkoutLogg.PageModels"
    x:DataType="vm:MyBookingsPageModel"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#7C3AED"
                Padding="20,52,20,20"
                StrokeShape="RoundRectangle 0,0,28,28"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" BackgroundColor="#9333EA" Padding="10,8"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="Center">
                    <Label Text="←" FontSize="18" TextColor="White" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Label Grid.Column="1" Margin="12,0,0,0" Text="{loc:Translate Bookings_Title}"
                       FontAttributes="Bold" FontSize="20" TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="0">

                <CollectionView ItemsSource="{Binding Bookings}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookingItem">
                            <Border BackgroundColor="White" Padding="16,14" Margin="0,0,0,10"
                                    Stroke="#F3F4F6" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#EDE9FE" WidthRequest="44" HeightRequest="44"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                                        <Label Text="{Binding Emoji}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding StatusLabel}" FontAttributes="Bold" FontSize="14"
                                               TextColor="{Binding StatusColor}" />
                                        <Label Text="{Binding SubLabel}" FontSize="12" TextColor="#6B7280"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#FEF2F2" Padding="12,6" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            IsVisible="{Binding CanCancel}">
                                        <Label Text="{loc:Translate Bookings_Cancel}" FontAttributes="Bold" FontSize="12" TextColor="#EF4444">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCancelTapped" CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="0,48" Spacing="10" HorizontalOptions="Center">
                    <Label FontSize="40" HorizontalOptions="Center" Text="📅" />
                    <Label FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"
                           Text="{loc:Translate Bookings_Empty}" TextColor="#111827" />
                    <Label FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           Text="{loc:Translate Bookings_EmptySubtitle}" TextColor="#9CA3AF" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
