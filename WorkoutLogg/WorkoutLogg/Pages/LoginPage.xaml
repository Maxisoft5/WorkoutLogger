<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:fonts="clr-namespace:Fonts"
    BackgroundColor="#EEEEF6"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,60,28,40"
            Spacing="0">

            <!-- App Icon -->
            <Border
                Margin="0,0,0,28"
                BackgroundColor="#7C3AED"
                HeightRequest="100"
                WidthRequest="100"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Text="💪"
                    VerticalOptions="Center" />
            </Border>

            <!-- Title -->
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSansBold"
                FontSize="32"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,8"
                Text="{loc:Translate Login_Welcome}"
                TextColor="#111827" />

            <!-- Subtitle -->
            <Label
                FontFamily="OpenSans"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,40"
                Text="{loc:Translate Login_Subtitle}"
                TextColor="#9CA3AF" />

            <!-- EMAIL Label -->
            <Label
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="11"
                Margin="4,0,0,8"
                Text="{loc:Translate Login_EmailLabel}"
                TextColor="#6B7280" />

            <!-- Email Entry -->
            <Border
                x:Name="EmailBorder"
                Margin="0,0,0,20"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1.5">
                <Entry
                    x:Name="EmailEntry"
                    FontFamily="OpenSans"
                    FontSize="16"
                    Keyboard="Email"
                    Margin="16,0"
                    Placeholder=""
                    PlaceholderColor="Black"
                    ReturnType="Next"
                    TextColor="#111827"
                    VerticalOptions="Center" />
            </Border>
            <Label x:Name="EmailError" Margin="4,0,0,12" FontSize="12" TextColor="#EF4444" IsVisible="False" />

            <!-- PASSWORD Label -->
            <Label
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="11"
                Margin="4,0,0,8"
                Text="{loc:Translate Login_PasswordLabel}"
                TextColor="#6B7280" />

            <!-- Password Entry -->
            <Border
                x:Name="PasswordBorder"
                Margin="0,0,0,12"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1.5">
                <Grid ColumnDefinitions="*,44">
                    <Entry
                        x:Name="PasswordEntry"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSans"
                        FontSize="16"
                        IsPassword="True"
                        Margin="16,0,0,0"
                        Placeholder="••••••••"
                        PlaceholderColor="#D1D5DB"
                        ReturnType="Done"
                        TextColor="#111827"
                        VerticalOptions="Center" />
                    <Image
                        x:Name="PasswordEyeImage"
                        Grid.Column="1"
                        HeightRequest="20"
                        WidthRequest="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                Glyph="{x:Static fonts:FluentUI.eye_20_regular}"
                                FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                Color="#9CA3AF"
                                Size="20"/>
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>
            <Label x:Name="PasswordError" Margin="4,0,0,12" FontSize="12" TextColor="#EF4444" IsVisible="False" />

            <!-- Forgot Password -->
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="14"
                HorizontalOptions="End"
                Margin="0,0,4,32"
                Text="{loc:Translate Login_ForgotPassword}"
                TextColor="#7C3AED">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Sign In Button -->
            <Border
                Margin="0,0,0,28"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7C3AED" Offset="0" />
                        <GradientStop Color="#9333EA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button
                    x:Name="SignInButton"
                    BackgroundColor="Transparent"
                    Clicked="OnSignInClicked"
                    FontAttributes="Bold"
                    FontFamily="OpenSans"
                    FontSize="17"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Text="{loc:Translate Login_SignIn}"
                    TextColor="White" />
            </Border>

            <!-- Sign Up Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label
                    FontFamily="OpenSans"
                    FontSize="14"
                    Text="{loc:Translate Login_NoAccount}"
                    TextColor="#9CA3AF"
                    VerticalOptions="Center" />
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSans"
                    FontSize="14"
                    Text="{loc:Translate Login_SignUp}"
                    TextColor="#7C3AED"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
