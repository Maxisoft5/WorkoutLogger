<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:fonts="clr-namespace:Fonts"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,60,28,40"
            Spacing="0">

            <!-- App Icon -->
            <Border
                Margin="0,0,0,28"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                HeightRequest="100"
                WidthRequest="100"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Style="{StaticResource IconBrand}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <!-- Title -->
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSansBold"
                FontSize="32"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,8"
                Text="{loc:Translate Login_Welcome}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />

            <!-- Subtitle -->
            <Label
                FontFamily="OpenSans"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,40"
                Text="{loc:Translate Login_Subtitle}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

            <!-- EMAIL Label -->
            <Label
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="11"
                Margin="4,0,0,8"
                Text="{loc:Translate Login_EmailLabel}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />

            <!-- Email Entry -->
            <Border
                x:Name="EmailBorder"
                Margin="0,0,0,20"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1.5">
                <Entry
                    x:Name="EmailEntry"
                    FontFamily="OpenSans"
                    FontSize="16"
                    Keyboard="Email"
                    Margin="16,0"
                    Placeholder=""
                    PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                    ReturnType="Next"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                    VerticalOptions="Center" />
            </Border>
            <Label x:Name="EmailError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- PASSWORD Label -->
            <Label
                CharacterSpacing="1.5"
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="11"
                Margin="4,0,0,8"
                Text="{loc:Translate Login_PasswordLabel}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />

            <!-- Password Entry -->
            <Border
                x:Name="PasswordBorder"
                Margin="0,0,0,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1.5">
                <Grid ColumnDefinitions="*,48">
                    <Entry
                        x:Name="PasswordEntry"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSans"
                        FontSize="16"
                        IsPassword="True"
                        Margin="16,0,0,0"
                        Placeholder="••••••••"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                        ReturnType="Done"
                        TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="1" MinimumHeightRequest="48" WidthRequest="48" BackgroundColor="Transparent" SemanticProperties.Description="{loc:Translate Common_TogglePassword}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                        </Grid.GestureRecognizers>
                    <Image InputTransparent="True"
                        x:Name="PasswordEyeImage"
                        HeightRequest="20"
                        WidthRequest="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                Glyph="{x:Static fonts:FluentUI.eye_20_regular}"
                                FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                Color="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                Size="20"/>
                        </Image.Source>
                    </Image>
                    </Grid>
                </Grid>
            </Border>
            <Label x:Name="PasswordError" Margin="4,0,0,12" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeDangerLight}, Dark={StaticResource ThemeDangerDark}}" IsVisible="False" />

            <!-- Forgot Password -->
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSans"
                FontSize="14"
                HorizontalOptions="End"
                Margin="0,0,4,32"
                Text="{loc:Translate Login_ForgotPassword}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Sign In Button -->
            <Border
                Margin="0,0,0,28"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button
                    x:Name="SignInButton"
                    BackgroundColor="Transparent"
                    Clicked="OnSignInClicked"
                    FontAttributes="Bold"
                    FontFamily="OpenSans"
                    FontSize="17"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Text="{loc:Translate Login_SignIn}"
                    TextColor="White" />
            </Border>

            <!-- Sign Up Link -->
            <Label FontFamily="OpenSans" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{loc:Translate Login_NoAccount}" />
                        <Span Text=" " />
                        <Span FontAttributes="Bold" Text="{loc:Translate Login_SignUp}" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignUpTapped" />
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
