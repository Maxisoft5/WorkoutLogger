<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.ChatThreadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#7C3AED"
                Padding="20,52,20,20"
                StrokeShape="RoundRectangle 0,0,28,28"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" BackgroundColor="#9333EA" Padding="10,8"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="Center">
                    <Label Text="←" FontSize="18" TextColor="White" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="TitleLabel" Text="{loc:Translate Chat_Thread_Title}"
                           FontAttributes="Bold" FontSize="18" TextColor="White" />
                    <Label Text="{loc:Translate Chat_Thread_Subtitle}" FontSize="11" TextColor="#DDD6FE" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollView x:Name="MessagesScroll" Grid.Row="1">
            <VerticalStackLayout x:Name="MessagesPanel" Padding="20,16,20,16" Spacing="8">
                <!-- Empty state -->
                <VerticalStackLayout x:Name="EmptyState" Padding="0,48" Spacing="10" HorizontalOptions="Center" IsVisible="False">
                    <Label FontSize="40" HorizontalOptions="Center" Text="💬" />
                    <Label FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           Text="{loc:Translate Chat_Thread_Empty}" TextColor="#9CA3AF" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Input bar -->
        <Border Grid.Row="2" BackgroundColor="White" Padding="16,10,16,24"
                Stroke="#F3F4F6" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20" Padding="14,0">
                    <Entry x:Name="MessageEntry" Placeholder="{loc:Translate Chat_Thread_Placeholder}"
                           FontSize="14" TextColor="#111827" ReturnType="Send" Completed="OnSendCompleted" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="#7C3AED" WidthRequest="44" HeightRequest="44"
                        StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                    <Label Text="➤" FontSize="18" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Border>

        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
