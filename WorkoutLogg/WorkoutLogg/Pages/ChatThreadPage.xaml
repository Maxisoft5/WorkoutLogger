<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.ChatThreadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                Padding="20,52,20,20"
                StrokeShape="RoundRectangle 0,0,28,28"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Padding="0"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="Center">
                    <Label Style="{StaticResource IconBackAction}" TextColor="White" VerticalOptions="Center" SemanticProperties.Description="{loc:Translate Common_Back}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="TitleLabel" Text="{loc:Translate Chat_Thread_Title}"
                           FontAttributes="Bold" FontSize="18" TextColor="White" />
                    <Label Text="{loc:Translate Chat_Thread_Subtitle}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ThemeOnHeroMutedLight}, Dark={StaticResource ThemeOnHeroMutedDark}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollView x:Name="MessagesScroll" Grid.Row="1">
            <VerticalStackLayout x:Name="MessagesPanel" Padding="20,16,20,16" Spacing="8">
                <!-- Empty state -->
                <VerticalStackLayout x:Name="EmptyState" Padding="0,48" Spacing="10" HorizontalOptions="Center" IsVisible="False">
                    <Label Style="{StaticResource IconChat}" FontSize="40" HorizontalOptions="Center" />
                    <Label FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           Text="{loc:Translate Chat_Thread_Empty}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Input bar -->
        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,10,16,24"
                Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20" Padding="14,0">
                    <Entry x:Name="MessageEntry" Placeholder="{loc:Translate Chat_Thread_Placeholder}"
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" ReturnType="Send" Completed="OnSendCompleted" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" WidthRequest="48" HeightRequest="48"
                        StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                    <Label Style="{StaticResource IconSendAction}" TextColor="White" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="{loc:Translate Common_Send}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Border>

        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
