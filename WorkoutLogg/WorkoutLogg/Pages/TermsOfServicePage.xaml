<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.TermsOfServicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Fixed header: Back button -->
        <HorizontalStackLayout Grid.Row="0" Margin="28,52,28,20" Spacing="8">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                <Label Style="{StaticResource IconBackAction}" HorizontalOptions="Fill" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Fill" SemanticProperties.Description="{localization:Translate Common_Back}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </HorizontalStackLayout>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,0,28,48" Spacing="0">

                <!-- Title row -->
                <HorizontalStackLayout Margin="0,0,0,4" Spacing="14" VerticalOptions="Center">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" StrokeShape="RoundRectangle 14"
                            StrokeThickness="0" VerticalOptions="Center">
                        <Label Style="{StaticResource IconDocument}" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="26" Text="Terms of Service" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                        <Label FontSize="12" Text="Last updated: April 28, 2026" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Intro banner -->
                <Border Margin="0,20,0,24" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" Padding="18,14" Stroke="{AppThemeBinding Light={StaticResource ThemeOnHeroMutedLight}, Dark={StaticResource ThemeOnHeroMutedDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                    <Label FontSize="14" LineBreakMode="WordWrap" Text="Please read these terms carefully before using Workout Logger. They govern your use of our service." TextColor="{AppThemeBinding Light={StaticResource ThemeVioletLight}, Dark={StaticResource ThemeVioletDark}}" />
                </Border>

                <!-- 1. Acceptance of Terms -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconDocument}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="1. Acceptance of Terms" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="By creating an account you agree to these Terms of Service. If you do not agree, please do not use Workout Logger." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. User Account -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconProfile}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="2. User Account" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="You must be 16 years or older to use this service. You are responsible for maintaining the confidentiality of your account credentials and all activity under your account." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Permitted Use -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconCheckCircle}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="3. Permitted Use" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Workout Logger is for personal fitness tracking. You may not reverse-engineer, scrape, or use the service to build competing products. Automated access without prior written consent is prohibited." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Health Disclaimer -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconBrand}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="4. Health Disclaimer" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Workout Logger does not provide medical advice. Always consult a qualified healthcare professional before starting a new exercise or nutrition program. Use the app at your own risk." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Premium Subscription -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconPremium}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="5. Premium Subscription" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Premium plans are billed monthly or annually. Subscriptions auto-renew unless cancelled at least 24 hours before the renewal date. Refunds follow the App Store / Google Play policies." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 6. Content Ownership -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconShield}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="6. Content Ownership" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Your workout data belongs to you. You grant us a limited licence to process it to provide the service. We grant you a non-exclusive licence to use our app content for personal use only." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 7. Termination -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconProhibited}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="7. Termination" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="We may suspend or terminate accounts that violate these terms. You may delete your account at any time via Settings → Account → Delete Account." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 8. Governing Law -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconLegal}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="8. Governing Law" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="These terms are governed by the laws of the European Union. Disputes will be resolved in the courts of Germany unless local consumer laws require otherwise." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 9. Contact -->
                <Border Margin="0,0,0,0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconMail}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="9. Contact" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Questions about these terms:&#10;legal@workoutlogger.app" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
