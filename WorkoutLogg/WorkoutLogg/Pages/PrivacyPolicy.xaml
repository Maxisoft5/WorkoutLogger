<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.PrivacyPolicy"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <!-- Fixed header: Back button -->
        <HorizontalStackLayout Grid.Row="0" Margin="28,52,28,20" Spacing="8">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                <Label Style="{StaticResource IconBackAction}" HorizontalOptions="Fill" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Fill" SemanticProperties.Description="{localization:Translate Common_Back}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </HorizontalStackLayout>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,0,28,48" Spacing="0">

                <!-- Title row -->
                <HorizontalStackLayout Margin="0,0,0,4" Spacing="14" VerticalOptions="Center">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Style="{StaticResource IconShield}" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="26" Text="Privacy Policy" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                        <Label FontSize="12" Text="Last updated: April 28, 2026" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Intro banner -->
                <Border Margin="0,20,0,24" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" Padding="18,14" Stroke="{AppThemeBinding Light={StaticResource ThemeOnHeroMutedLight}, Dark={StaticResource ThemeOnHeroMutedDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                    <Label FontSize="14" LineBreakMode="WordWrap" Text="Your privacy matters. This policy explains what we collect, why, and how you stay in control." TextColor="{AppThemeBinding Light={StaticResource ThemeVioletLight}, Dark={StaticResource ThemeVioletDark}}" />
                </Border>

                <!-- Section: Information We Collect -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconJournal}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Information We Collect" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="We collect information you provide directly: name, email, body metrics (weight, height), and workout data. We also collect usage analytics to improve the app experience." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: How We Use Your Data -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconSettings}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="How We Use Your Data" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Your data is used solely to provide and improve the Workout Logger service — personalising your dashboard, tracking progress, and delivering notifications you've enabled." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Data Storage & Security -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconLock}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Data Storage &amp; Security" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="All data is encrypted in transit (TLS 1.3) and at rest (AES-256). Your workout history is stored on secure servers in the EU. We never sell your personal data to third parties." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Health Data -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconBrand}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Health Data" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="Body metrics and workout records are treated as sensitive health information. They are never shared with advertisers and are not used for profiling outside of the app." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Your Rights -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconLegal}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Your Rights" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="You may request access, correction, or deletion of your data at any time via Settings → Privacy → My Data. We respond within 30 days per GDPR requirements." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Third-Party Services -->
                <Border Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconLink}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Third-Party Services" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="We use Apple Sign In, Google Sign In, and anonymous analytics (no personal identifiers). Each provider's privacy policy governs their data handling." TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Contact Us -->
                <Border Margin="0,0,0,0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Style="{StaticResource IconMail}" FontSize="22" VerticalOptions="Center" />
                            <Label FontAttributes="Bold" FontSize="16" Text="Contact Us" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="14" LineBreakMode="WordWrap" Text="For privacy questions: privacy@workoutlogger.app&#10;Data Protection Officer: dpo@workoutlogger.app" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
