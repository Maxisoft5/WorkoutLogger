<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,52,20,12" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="DateLabel" CharacterSpacing="1" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        <Label x:Name="HelloUserText"
                               FontAttributes="Bold"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Grid Grid.Column="1"
                          WidthRequest="68" HeightRequest="68"
                          VerticalOptions="Center">
                        <!-- Initials -->
                        <Border x:Name="DashAvatarInitialsBorder"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                                HeightRequest="68"
                                WidthRequest="68"
                                StrokeShape="Ellipse"
                                StrokeThickness="0">
                            <Label x:Name="AvatarLabel"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </Border>
                        <!-- Profile photo -->
                        <Grid x:Name="DashAvatarPhotoBorder"
                              HeightRequest="68" WidthRequest="68"
                              IsVisible="False">
                            <Image x:Name="DashAvatarImage"
                                   Aspect="AspectFill"
                                   HeightRequest="68"
                                   WidthRequest="68">
                                <Image.Clip>
                                    <EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34" />
                                </Image.Clip>
                            </Image>
                            <Ellipse Stroke="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" StrokeThickness="2"
                                     HeightRequest="68" WidthRequest="68"
                                     Fill="Transparent" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*,8,*,8,*">
                    <!-- Total Workouts -->
                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="14,14"
                            Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource IconStrength}" FontSize="22" />
                            <Label x:Name="TotalWorkoutsLabel" FontAttributes="Bold" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" Text="0" />
                            <Label x:Name="WeeklyChangeLabel" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Text="+0 this week" />
                            <Label FontSize="11" Text="{loc:Translate Dashboard_TotalWorkouts}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Streak -->
                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="14,14"
                            Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource IconFire}" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                            <Label x:Name="StreakLabel" FontAttributes="Bold" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" Text="0" />
                            <Label FontSize="11" Text="{loc:Translate Dashboard_DayStreak}" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                            <Label FontSize="11" Text="{loc:Translate Dashboard_Streak}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Volume -->
                    <Border Grid.Column="4" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="14,14"
                            Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource IconProgress}" FontSize="22" />
                            <Label x:Name="WeekVolumeLabel" FontAttributes="Bold" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" Text="0 kg" />
                            <Label FontAttributes="Bold" FontSize="11" Text="{loc:Translate Dashboard_ThisWeek}" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                            <Label FontSize="11" Text="{loc:Translate Dashboard_Volume}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Weekly Activity -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="16">
                        <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Dashboard_WeeklyActivity}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                        <!-- Bar chart built in code-behind -->
                        <Grid x:Name="WeeklyBarsGrid" HeightRequest="90" ColumnSpacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Goals -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="16">
                        <Label FontAttributes="Bold" FontSize="16" Text="{loc:Translate Dashboard_WeeklyGoals}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                            <!-- Workouts goal -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" HeightRequest="74" WidthRequest="74"
                                        StrokeShape="Ellipse" StrokeThickness="0" HorizontalOptions="Center">
                                    <Label x:Name="WorkoutsGoalPct" FontAttributes="Bold" FontSize="14"
                                           HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" VerticalOptions="Center" Text="0%" />
                                </Border>
                                <Label x:Name="WorkoutsGoalSub" FontSize="11" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" Text="0 / 4" />
                                <Label FontSize="11" HorizontalOptions="Center" Text="{loc:Translate Dashboard_Workouts}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                            </VerticalStackLayout>

                            <!-- Volume goal -->
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" HeightRequest="74" WidthRequest="74"
                                        StrokeShape="Ellipse" StrokeThickness="0" HorizontalOptions="Center">
                                    <Label x:Name="VolumeGoalPct" FontAttributes="Bold" FontSize="14"
                                           HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" VerticalOptions="Center" Text="0%" />
                                </Border>
                                <Label x:Name="VolumeGoalSub" FontSize="11" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" Text="0 / 5 000" />
                                <Label FontSize="11" HorizontalOptions="Center" Text="{loc:Translate Dashboard_VolumeKg}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                            </VerticalStackLayout>

                            <!-- Consistency goal -->
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" HeightRequest="74" WidthRequest="74"
                                        StrokeShape="Ellipse" StrokeThickness="0" HorizontalOptions="Center">
                                    <Label x:Name="ConsistencyGoalPct" FontAttributes="Bold" FontSize="14"
                                           HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" VerticalOptions="Center" Text="0%" />
                                </Border>
                                <Label x:Name="ConsistencyGoalSub" FontSize="11" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" Text="0 / 5" />
                                <Label FontSize="11" HorizontalOptions="Center" Text="{loc:Translate Dashboard_ActiveDays}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Last Workout -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="18,16"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" FontAttributes="Bold" FontSize="16" Text="{loc:Translate Dashboard_LastWorkout}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="13" Text="{loc:Translate Dashboard_SeeAll}" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSeeAllWorkoutsTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Has workout -->
                        <Grid x:Name="LastWorkoutCard" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}"
                                    HeightRequest="72"
                                    WidthRequest="72"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label x:Name="LastWorkoutEmoji" FontSize="24"
                                       HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource FitnessIcon}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label x:Name="LastWorkoutTitle" FontAttributes="Bold" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" Text="—" />
                                <Label x:Name="LastWorkoutSub" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" Text="—" />
                            </VerticalStackLayout>
                            <Label x:Name="LastWorkoutVolume" Grid.Column="2"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" VerticalOptions="Center" Text="—" />
                        </Grid>

                        <!-- No workout placeholder -->
                        <Label x:Name="NoWorkoutLabel"
                               IsVisible="False"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                               HorizontalOptions="Center"
                               Text="{loc:Translate Dashboard_NoWorkouts}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <controls:MainTabBar Grid.Row="1" ActiveTab="Dashboard" />
        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="2" />

    </Grid>
</ContentPage>
