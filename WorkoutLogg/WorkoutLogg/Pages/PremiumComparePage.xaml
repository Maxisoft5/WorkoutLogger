<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.PremiumComparePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,52,20,16" Spacing="0">

                <!-- Back -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" HeightRequest="48" WidthRequest="48"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Margin="0,0,0,20">
                    <Label Style="{StaticResource IconBackAction}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Title -->
                <Label Text="{loc:Translate Premium_Compare_Title}"
                       FontAttributes="Bold" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                       Margin="0,0,0,4" />
                <Label Text="{loc:Translate Premium_Compare_Subtitle}"
                       FontSize="13" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" Margin="0,0,0,20" />

                <!-- Comparison table -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="0">

                        <!-- Header -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,12" ColumnSpacing="0">
                            <Label Grid.Column="0"
                                   Text="{loc:Translate Premium_Compare_Feature}"
                                   FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{loc:Translate Premium_Compare_Free}"
                                   FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="PREMIUM"
                                   FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" />

                        <!-- Row: Logging -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Logging}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: Plans -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Plans}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: Stats (text cells) -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Stats}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{loc:Translate Premium_Row_Stats_Free}"
                                   FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="{loc:Translate Premium_Row_Stats_Prem}"
                                   FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: Muscle analytics -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Muscles}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="—" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: AI Coach -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_AiCoach}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="—" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: AI Forecast -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Forecast}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="—" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: AI Plan Gen -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_PlanGen}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="—" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" HeightRequest="1" Margin="16,0" />

                        <!-- Row: Export -->
                        <Grid ColumnDefinitions="*,64,84" Padding="16,13" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="{loc:Translate Premium_Row_Export}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="—" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource IconCheck}" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeSuccessLight}, Dark={StaticResource ThemeSuccessDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- AI teaser card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                        Padding="16,14"
                        StrokeShape="RoundRectangle 20" StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}"
                                HeightRequest="55" WidthRequest="55"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                VerticalOptions="Start">
                            <Label Style="{StaticResource IconCoach}" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate Premium_AI_Teaser_Title}"
                                   FontAttributes="Bold" FontSize="13" TextColor="White" />
                            <Label Text="{loc:Translate Premium_AI_Teaser_Desc}"
                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ThemeOnHeroMutedLight}, Dark={StaticResource ThemeOnHeroMutedDark}}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- CTA -->
        <VerticalStackLayout Grid.Row="1" Padding="20,12,20,28" BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                    Padding="16" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                <Label Text="{loc:Translate Premium_CTA_Upgrade}"
                       FontAttributes="Bold" FontSize="15" TextColor="White"
                       HorizontalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpgradeTapped" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
