<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.EditBodyStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20,52,20,16">
            <Button Grid.Column="0"
                    BackgroundColor="Transparent"
                    Clicked="OnBackTapped"
                    FontSize="22"
                    Text="‹"
                    TextColor="#7C3AED"
                    Padding="0"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Text="{loc:Translate EditStats_Title}"
                   TextColor="#111827"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="16">

                <!-- Weight -->
                <Border BackgroundColor="White" Padding="16" Stroke="#F3F4F6"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_Weight}" TextColor="#9CA3AF" />
                        <Entry x:Name="WeightEntry"
                               Keyboard="Numeric"
                               Placeholder="82"
                               PlaceholderColor="#D1D5DB"
                               TextColor="#111827"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Height -->
                <Border BackgroundColor="White" Padding="16" Stroke="#F3F4F6"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_Height}" TextColor="#9CA3AF" />
                        <Entry x:Name="HeightEntry"
                               Keyboard="Numeric"
                               Placeholder="180"
                               PlaceholderColor="#D1D5DB"
                               TextColor="#111827"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Body Fat -->
                <Border BackgroundColor="White" Padding="16" Stroke="#F3F4F6"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_BodyFat}" TextColor="#9CA3AF" />
                        <Entry x:Name="BodyFatEntry"
                               Keyboard="Numeric"
                               Placeholder="15"
                               PlaceholderColor="#D1D5DB"
                               TextColor="#111827"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Padding="20,16"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="12" Opacity="0.06" />
            </Border.Shadow>
            <Button x:Name="SaveButton"
                    BackgroundColor="#7C3AED"
                    Clicked="OnSaveClicked"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="52"
                    Text="{loc:Translate Common_Save}"
                    TextColor="White" />
        </Border>

    </Grid>
</ContentPage>
