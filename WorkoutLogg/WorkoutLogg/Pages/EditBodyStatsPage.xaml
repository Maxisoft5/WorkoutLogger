<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.EditBodyStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20,52,20,16">
            <Button Grid.Column="0"
                    BackgroundColor="Transparent"
                    Clicked="OnBackTapped"
                    FontSize="22"
                    Style="{StaticResource IconBackButton}" SemanticProperties.Description="{loc:Translate Common_Back}"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                    Padding="0"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Text="{loc:Translate EditStats_Title}"
                   TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="16">

                <!-- Weight -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_Weight}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        <Entry x:Name="WeightEntry"
                               Keyboard="Numeric"
                               Placeholder="82"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Height -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_Height}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        <Entry x:Name="HeightEntry"
                               Keyboard="Numeric"
                               Placeholder="180"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Body Fat -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}"
                        StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="11" CharacterSpacing="1"
                               Text="{loc:Translate EditStats_BodyFat}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                        <Entry x:Name="BodyFatEntry"
                               Keyboard="Numeric"
                               Placeholder="15"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                Padding="20,16"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="12" Opacity="0.06" />
            </Border.Shadow>
            <Button x:Name="SaveButton"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                    Clicked="OnSaveClicked"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="52"
                    Text="{loc:Translate Common_Save}"
                    TextColor="White" />
        </Border>

    </Grid>
</ContentPage>
