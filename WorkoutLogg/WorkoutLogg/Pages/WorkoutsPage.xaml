<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.WorkoutsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:theme="clr-namespace:WorkoutLogg.Utilities"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:pagemodels="clr-namespace:WorkoutLogg.PageModels"
    xmlns:vm="clr-namespace:WorkoutLogg.PageModels"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <CollectionView x:Name="WorkoutsList" Grid.Row="0" ItemsSource="{Binding Workouts}" SelectionMode="None">
            <CollectionView.Header>
            <VerticalStackLayout Padding="20,52,20,12" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label FontAttributes="Bold" FontSize="28" Text="{loc:Translate Workouts_Title}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                        <Label x:Name="SessionCountLabel" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                            Padding="0" MinimumWidthRequest="48" MinimumHeightRequest="48"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Style="{StaticResource IconAddAction}"
                               SemanticProperties.Description="{loc:Translate AddWorkout_AddBtn}"
                               TextColor="White"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddWorkoutTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

                <!-- Filter chips -->
                <controls:HorizontalScrollHint>
                    <HorizontalStackLayout Spacing="8">
                        <Border x:Name="FilterAll" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" Padding="16,8" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                            <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate Workouts_Filter_All}" TextColor="White">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="All" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="FilterStrength" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,8" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 20" StrokeThickness="1.5">
                            <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate Workouts_Filter_Strength}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Strength" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="FilterCardio" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,8" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 20" StrokeThickness="1.5">
                            <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate Workouts_Filter_Cardio}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Cardio" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="FilterStretch" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,8" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 20" StrokeThickness="1.5">
                            <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate Workouts_Filter_Stretch}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Stretch" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </HorizontalStackLayout>
                </controls:HorizontalScrollHint>

                <!-- Calendar -->
                <controls:CalendarPicker
                    x:Name="Calendar"
                    AccentColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                    DateSelected="OnDateSelected" />

            </VerticalStackLayout>
            </CollectionView.Header>
                <!-- Список получает ограниченную высоту Grid и виртуализирует элементы. -->
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutDisplayItem">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Margin="20,0" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{theme:ThemeBinding Path=IconBackground, Background=True}"
                                            HeightRequest="68"
                                            WidthRequest="68"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label FontSize="22"
                                               HorizontalOptions="Center"
                                               Text="{Binding Emoji}" Style="{StaticResource FitnessIcon}"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <!-- Name + subtitle -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label FontAttributes="Bold" FontSize="15" Text="{Binding TypeLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                                        <Label FontSize="12" Text="{Binding SubLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                                    </VerticalStackLayout>
                                    <!-- Weight + type -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                        <Label FontAttributes="Bold"
                                               FontSize="13"
                                               HorizontalOptions="End"
                                               Text="{Binding WeightLabel}"
                                               TextColor="{theme:ThemeBinding Path=WeightColor, Background=False}" />
                                        <Label FontSize="11"
                                               HorizontalOptions="End"
                                               Text="{Binding TypeLabel}"
                                               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                                    </VerticalStackLayout>
                                    <!-- Options ⋮ -->
                                    <Label Grid.Column="3"
                                           FontAttributes="Bold"
                                           FontSize="20"
                                           HorizontalOptions="End"
                                            Style="{StaticResource IconMoreAction}"
                                            SemanticProperties.Description="{loc:Translate Common_MoreActions}"
                                           TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}"
                                           VerticalOptions="Center"
                                           Padding="4,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="OnWorkoutOptionsTapped"
                                                CommandParameter="{Binding Id}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                <!-- Empty state (shown when no workouts match the current filter) -->
                <CollectionView.Footer>
                <VerticalStackLayout
                    IsVisible="{Binding IsEmpty}"
                    Padding="0,32"
                    Spacing="10"
                    HorizontalOptions="Center">
                    <Label Style="{StaticResource IconStrength}" FontSize="40" HorizontalOptions="Center" />
                    <Label FontAttributes="Bold"
                           FontSize="16"
                           HorizontalOptions="Center"
                           Text="{loc:Translate Workouts_Empty}"
                           TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                    <Label FontSize="14"
                           HorizontalOptions="Center"
                           Text="{loc:Translate Workouts_EmptySubtitle}"
                           TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                </VerticalStackLayout>

                </CollectionView.Footer>
        </CollectionView>

        <controls:MainTabBar Grid.Row="1" ActiveTab="Workouts" />
        <controls:LoadingOverlayView x:Name="PageLoading" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
