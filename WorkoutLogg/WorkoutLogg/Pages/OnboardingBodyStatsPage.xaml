<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.OnboardingBodyStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Step indicator -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,52,0,32" Spacing="6">
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="28" Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,0" Spacing="0">

                <!-- Step label -->
                <Label CharacterSpacing="1" FontAttributes="Bold" FontSize="11" Margin="0,0,0,10" Text="{loc:Translate Onboarding_Step2}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                <Label FontAttributes="Bold" FontSize="28" Margin="0,0,0,8" Text="{loc:Translate Onboarding_BodyTitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                <Label FontSize="14" Margin="0,0,0,28" Text="{loc:Translate Onboarding_BodySubtitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

                <!-- Weight / Height Cards -->
                <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,20">

                    <!-- Weight Card -->
                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,20" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label CharacterSpacing="1" FontAttributes="Bold" FontSize="10" HorizontalOptions="Center" Text="{loc:Translate Onboarding_WeightLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                            <Label Style="{StaticResource IconUpAction}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" SemanticProperties.Description="{loc:Translate Onboarding_IncreaseWeight}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWeightUpTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="WeightLabel" FontAttributes="Bold" FontSize="40" HorizontalOptions="Center" Text="82" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                            <Label x:Name="WeightUnitLabel" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="kg" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                            <Label Style="{StaticResource IconDownAction}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" SemanticProperties.Description="{loc:Translate Onboarding_DecreaseWeight}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWeightDownTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Height Card -->
                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16,20" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label CharacterSpacing="1" FontAttributes="Bold" FontSize="10" HorizontalOptions="Center" Text="{loc:Translate Onboarding_HeightLabel}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                            <Label Style="{StaticResource IconUpAction}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" SemanticProperties.Description="{loc:Translate Onboarding_IncreaseHeight}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHeightUpTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeightLabel" FontAttributes="Bold" FontSize="40" HorizontalOptions="Center" Text="183" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                            <Label x:Name="HeightUnitLabel" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Text="cm" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                            <Label Style="{StaticResource IconDownAction}" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" SemanticProperties.Description="{loc:Translate Onboarding_DecreaseHeight}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHeightDownTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Body Fat % -->
                <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Onboarding_BodyFatOptional}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                <Border Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                    <Entry x:Name="BodyFatEntry" BackgroundColor="Transparent" FontSize="15" Keyboard="Numeric" Margin="14,0" Placeholder="22%" PlaceholderColor="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" VerticalOptions="Center" />
                </Border>

                <!-- Info Box -->
                <Border Margin="0,0,0,8" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentSoftLight}, Dark={StaticResource ThemeAccentSoftDark}}" Padding="16,14" Stroke="{AppThemeBinding Light={StaticResource ThemeOnHeroMutedLight}, Dark={StaticResource ThemeOnHeroMutedDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource IconJournal}" FontSize="20" VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Onboarding_BodyFatNote}"
                            TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Back / Continue -->
        <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="28,16,28,40">
            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1.5">
                <Button BackgroundColor="Transparent" Clicked="OnBackClicked" FontAttributes="Bold" FontSize="15" Text="{loc:Translate Common_BackButton}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,12" />
            </Border>
            <Border Grid.Column="2" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button BackgroundColor="Transparent" Clicked="OnContinueClicked" FontAttributes="Bold" FontSize="15" Text="{loc:Translate Common_Continue}" TextColor="White" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,12" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
