<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.AddWorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    xmlns:controls="clr-namespace:WorkoutLogg.Pages.Controls"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,52,20,16">
            <Button Grid.Column="0"
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    FontSize="22"
                    Style="{StaticResource IconBackButton}" SemanticProperties.Description="{loc:Translate Common_Back}"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}"
                    Padding="0"
                    VerticalOptions="Center" />
            <Label x:Name="PageTitle"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Scrollable form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="16">

                <!-- Workout Type -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate AddWorkout_WorkoutType}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                        <controls:HorizontalScrollHint>
                            <HorizontalStackLayout x:Name="TypeChips" Spacing="8" />
                        </controls:HorizontalScrollHint>
                    </VerticalStackLayout>
                </Border>

                <!-- Date & Duration -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Padding="16" Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold" FontSize="13" Text="{loc:Translate AddWorkout_Date}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                        <DatePicker x:Name="WorkoutDatePicker"
                                    MinimumDate="01/01/2020"
                                    MaximumDate="12/31/2030"
                                    Format="dddd, d MMMM yyyy"
                                    TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                                    FontSize="15" />
                        <Grid ColumnDefinitions="*,16,*" ColumnSpacing="0">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label FontSize="12" Text="{loc:Translate AddWorkout_StartTime}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                                <TimePicker x:Name="StartTimePicker" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" FontSize="15" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label FontSize="12" Text="{loc:Translate AddWorkout_EndTime}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                                <TimePicker x:Name="EndTimePicker" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" FontSize="15" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Exercises -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           FontAttributes="Bold"
                           FontSize="17"
                           Text="{loc:Translate AddWorkout_Exercises}"
                           TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            MinimumHeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddExerciseTapped" />
                        </Border.GestureRecognizers>
                        <Label FontAttributes="Bold" InputTransparent="True" VerticalOptions="Center"
                               FontSize="13"
                               Text="{loc:Translate AddWorkout_AddBtn}"
                               TextColor="White">
                        </Label>
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="ExercisesList" Spacing="12" />

                <!-- Empty state for exercises -->
                <Border x:Name="ExercisesEmpty"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                        Padding="24"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Style="{StaticResource IconStrength}" FontSize="36" HorizontalOptions="Center" />
                        <Label FontSize="14"
                               HorizontalOptions="Center"
                               Text="{loc:Translate AddWorkout_EmptyExercises}"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                Padding="20,16"
                Stroke="{AppThemeBinding Light={StaticResource ThemeSoftLight}, Dark={StaticResource ThemeSoftDark}}"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="12" Opacity="0.06" />
            </Border.Shadow>
            <Button BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                    Clicked="OnSaveClicked"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="52"
                    Text="{loc:Translate AddWorkout_Save}"
                    TextColor="White" />
        </Border>

    </Grid>
</ContentPage>
