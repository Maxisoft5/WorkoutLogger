<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.PremiumPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="#EEEEF6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Hero -->
                <Border BackgroundColor="#7C3AED"
                        Padding="20,52,20,32"
                        StrokeShape="RoundRectangle 0,0,28,28"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Close / Restore row -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                            <Border Grid.Column="0"
                                    BackgroundColor="#9333EA"
                                    HeightRequest="64" WidthRequest="64"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                <Label Text="×" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Label Grid.Column="2"
                                   Text="{loc:Translate Premium_Restore}"
                                   TextColor="#DDD6FE" FontSize="12" FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRestoreTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Icon -->
                        <Border BackgroundColor="#9333EA"
                                HeightRequest="85" WidthRequest="85"
                                StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                HorizontalOptions="Center" Margin="0,0,0,14">
                            <Label Text="⭐" FontSize="32"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Title + subtitle -->
                        <Label HorizontalOptions="Center" FontAttributes="Bold" FontSize="26"
                               Margin="0,0,0,8">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="WorkoutLog " TextColor="White" FontAttributes="Bold" FontSize="26" />
                                    <Span Text="Premium" TextColor="#DDD6FE" FontAttributes="Bold" FontSize="26" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{loc:Translate Premium_Subtitle}"
                               TextColor="#DDD6FE" FontSize="13"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />

                    </VerticalStackLayout>
                </Border>

                <!-- Feature cards -->
                <VerticalStackLayout Padding="20,20,20,0" Spacing="8">

                    <Border BackgroundColor="White" Padding="14,12"
                            Stroke="#F3F4F6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <Grid ColumnDefinitions="65,*" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#EDE9FE"
                                    HeightRequest="65" WidthRequest="65"
                                    StrokeShape="RoundRectangle 13" StrokeThickness="0">
                                <Label Text="🤖" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Feature_AiCoach}"
                                       FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Feature_AiCoach_Desc}"
                                       FontSize="11" TextColor="#9CA3AF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="White" Padding="14,12"
                            Stroke="#F3F4F6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <Grid ColumnDefinitions="65,*" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#DCFCE7"
                                    HeightRequest="65" WidthRequest="65"
                                    StrokeShape="RoundRectangle 13" StrokeThickness="0">
                                <Label Text="📈" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Feature_Forecast}"
                                       FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Feature_Forecast_Desc}"
                                       FontSize="11" TextColor="#9CA3AF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="White" Padding="14,12"
                            Stroke="#F3F4F6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <Grid ColumnDefinitions="65,*" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#DBEAFE"
                                    HeightRequest="65" WidthRequest="65"
                                    StrokeShape="RoundRectangle 13" StrokeThickness="0">
                                <Label Text="📊" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Feature_Analytics}"
                                       FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Feature_Analytics_Desc}"
                                       FontSize="11" TextColor="#9CA3AF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="White" Padding="14,12"
                            Stroke="#F3F4F6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <Grid ColumnDefinitions="65,*" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#FEF3C7"
                                    HeightRequest="65" WidthRequest="65"
                                    StrokeShape="RoundRectangle 13" StrokeThickness="0">
                                <Label Text="🏋️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Feature_PlanGen}"
                                       FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Feature_PlanGen_Desc}"
                                       FontSize="11" TextColor="#9CA3AF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="White" Padding="14,12"
                            Stroke="#F3F4F6" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                        <Grid ColumnDefinitions="65,*" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#DCFCE7"
                                    HeightRequest="65" WidthRequest="65"
                                    StrokeShape="RoundRectangle 13" StrokeThickness="0">
                                <Label Text="📤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Feature_Export}"
                                       FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Feature_Export_Desc}"
                                       FontSize="11" TextColor="#9CA3AF" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Active subscription card (hidden when not subscribed) -->
                <VerticalStackLayout x:Name="SubscriptionActiveSection" IsVisible="False"
                                     Padding="20,16,20,0">
                    <Border BackgroundColor="White" Padding="20,18"
                            StrokeShape="RoundRectangle 18" StrokeThickness="1.5">
                        <Border.Stroke><SolidColorBrush Color="#7C3AED" /></Border.Stroke>
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#EDE9FE" Padding="8,4"
                                        StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label x:Name="SubStatusBadge"
                                           FontSize="11" FontAttributes="Bold" TextColor="#7C3AED" />
                                </Border>
                            </HorizontalStackLayout>
                            <BoxView BackgroundColor="#F3F4F6" HeightRequest="1" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{loc:Translate Premium_Active_Plan}"
                                       FontSize="13" TextColor="#6B7280" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="SubPlanLabel"
                                       FontAttributes="Bold" FontSize="14" TextColor="#111827"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{loc:Translate Premium_Active_Expires}"
                                       FontSize="13" TextColor="#6B7280" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="SubExpiryLabel"
                                       FontAttributes="Bold" FontSize="14" TextColor="#111827"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border BackgroundColor="#F0FDF4" Padding="14,10"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Label x:Name="SubDaysLeftLabel"
                                       FontAttributes="Bold" FontSize="15" TextColor="#16A34A"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Purchase section (hidden when already subscribed) -->
                <VerticalStackLayout x:Name="PurchaseSection">

                <!-- Plan selector -->
                <VerticalStackLayout Padding="20,16,20,0" Spacing="8">

                    <!-- Annual (pre-selected) -->
                    <Border x:Name="AnnualBorder"
                            BackgroundColor="#EDE9FE"
                            Padding="16,14"
                            StrokeShape="RoundRectangle 18" StrokeThickness="2">
                        <Border.Stroke>
                            <SolidColorBrush Color="#7C3AED" />
                        </Border.Stroke>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" x:Name="AnnualRadio"
                                    BackgroundColor="#7C3AED"
                                    HeightRequest="55" WidthRequest="55"
                                    StrokeShape="Ellipse" StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label x:Name="AnnualCheck" Text="✓"
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{loc:Translate Premium_Plan_Annual}"
                                           FontAttributes="Bold" FontSize="14" TextColor="#111827"
                                           VerticalOptions="Center" />
                                    <Border BackgroundColor="#7C3AED" Padding="6,2"
                                            StrokeShape="RoundRectangle 99" StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label Text="−40%" FontSize="9" FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{loc:Translate Premium_Plan_Annual_Sub}"
                                       FontSize="11" TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{loc:Translate Premium_Plan_Annual_Price}"
                                       FontAttributes="Bold" FontSize="16" TextColor="#111827"
                                       HorizontalOptions="End" />
                                <Label Text="{loc:Translate Premium_PerMonth}"
                                       FontSize="10" TextColor="#9CA3AF"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAnnualTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Monthly -->
                    <Border x:Name="MonthlyBorder"
                            BackgroundColor="White"
                            Padding="16,14"
                            StrokeShape="RoundRectangle 18" StrokeThickness="2">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E5E7EB" />
                        </Border.Stroke>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" x:Name="MonthlyRadio"
                                    BackgroundColor="Transparent"
                                    HeightRequest="55" WidthRequest="55"
                                    StrokeShape="Ellipse" StrokeThickness="2"
                                    VerticalOptions="Center">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#E5E7EB" />
                                </Border.Stroke>
                                <Label x:Name="MonthlyCheck" Text="✓"
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       IsVisible="False"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{loc:Translate Premium_Plan_Monthly}"
                                       FontAttributes="Bold" FontSize="14" TextColor="#111827" />
                                <Label Text="{loc:Translate Premium_Plan_Monthly_Sub}"
                                       FontSize="11" TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{loc:Translate Premium_Plan_Monthly_Price}"
                                       FontAttributes="Bold" FontSize="16" TextColor="#111827"
                                       HorizontalOptions="End" />
                                <Label Text="{loc:Translate Premium_PerMonth}"
                                       FontSize="10" TextColor="#9CA3AF"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMonthlyTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                </VerticalStackLayout>

                <!-- Compare link -->
                <Label Text="{loc:Translate Premium_CompareLink}"
                       TextColor="#7C3AED" FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0,16,0,20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompareTapped" />
                    </Label.GestureRecognizers>
                </Label>

                </VerticalStackLayout><!-- /PurchaseSection -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky bottom CTA -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20,12,20,28"
                             BackgroundColor="#EEEEF6"
                             Spacing="10">
            <Border BackgroundColor="#7C3AED"
                    Padding="16" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                <Label x:Name="CtaLabel"
                       Text="{loc:Translate Premium_CTA_Trial}"
                       FontAttributes="Bold" FontSize="15" TextColor="White"
                       HorizontalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCtaTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label x:Name="FootnoteLabel"
                   TextColor="#9CA3AF" FontSize="11"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
