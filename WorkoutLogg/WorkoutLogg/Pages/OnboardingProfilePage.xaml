<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkoutLogg.Pages.OnboardingProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WorkoutLogg.Localization"
    BackgroundColor="{AppThemeBinding Light={StaticResource ThemePageLight}, Dark={StaticResource ThemePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Step indicator -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,52,0,32" Spacing="6">
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="28" Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
            <BoxView CornerRadius="3" HeightRequest="6" WidthRequest="10" Color="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,0" Spacing="0">

                <!-- Step label -->
                <Label CharacterSpacing="1" FontAttributes="Bold" FontSize="11" Margin="0,0,0,10" Text="{loc:Translate Onboarding_Step1}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

                <!-- Title -->
                <Label FontAttributes="Bold" FontSize="28" Margin="0,0,0,8" Text="{loc:Translate Onboarding_ProfileTitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" />
                <Label FontSize="14" Margin="0,0,0,36" Text="{loc:Translate Onboarding_ProfileSubtitle}" TextColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}" />

                <!-- Avatar -->
                <Grid HorizontalOptions="Center" Margin="0,0,0,36" WidthRequest="150" HeightRequest="150">
                    <!-- Initials (hidden when photo selected) -->
                    <Border
                        x:Name="AvatarInitialsBorder"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}"
                        HeightRequest="120"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="120">
                        <Label
                            x:Name="AvatarLabel"
                            FontAttributes="Bold"
                            FontSize="36"
                            HorizontalOptions="Center"
                            Text="A"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                    <!-- Profile photo (visible when selected) -->
                    <Border
                        x:Name="AvatarPhotoBorder"
                        HeightRequest="120"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="120"
                        IsVisible="False">
                        <Image x:Name="AvatarImage"
                               Aspect="AspectFill"
                               HeightRequest="120"
                               WidthRequest="120" />
                    </Border>
                    <!-- Edit badge -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                        HeightRequest="56"
                        HorizontalOptions="End"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        VerticalOptions="End"
                        WidthRequest="56">
                        <Label Style="{StaticResource IconEditAction}" TextColor="White" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="{loc:Translate Profile_ChangePhoto}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangeAvatarTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

                <!-- DATE OF BIRTH -->
                <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,8" Text="{loc:Translate Onboarding_DateOfBirth}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                <Border Margin="0,0,0,16" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                    <DatePicker
                        x:Name="BirthDatePicker"
                        BackgroundColor="Transparent"
                        Format="dd / MM / yyyy"
                        FontSize="15"
                        Margin="14,0"
                        TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}"
                        VerticalOptions="Center"
                        xmlns:sys="clr-namespace:System;assembly=netstandard" />
                </Border>

                <!-- BIOLOGICAL SEX -->
                <Label CharacterSpacing="1.2" FontAttributes="Bold" FontSize="11" Margin="4,0,0,12" Text="{loc:Translate Onboarding_BiologicalSex}" TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}" />
                <Grid Margin="0,0,0,8" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border x:Name="MaleBorder" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeHeroLight}, Dark={StaticResource ThemeHeroDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                        <Button x:Name="MaleButton" BackgroundColor="Transparent" Clicked="OnMaleSelected" FontAttributes="Bold" FontSize="14" Text="{loc:Translate Onboarding_Male}" TextColor="White" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,10" />
                    </Border>
                    <Border x:Name="FemaleBorder" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                        <Button x:Name="FemaleButton" BackgroundColor="Transparent" Clicked="OnFemaleSelected" FontAttributes="Bold" FontSize="14" Text="{loc:Translate Onboarding_Female}" TextColor="{AppThemeBinding Light={StaticResource ThemeTextLight}, Dark={StaticResource ThemeTextDark}}" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,10" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Continue Button -->
        <Border Grid.Row="2" Margin="28,16,28,40" StrokeShape="RoundRectangle 14" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource ThemeHeroRaisedLight}, Dark={StaticResource ThemeHeroRaisedDark}}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Button BackgroundColor="Transparent" Clicked="OnContinueClicked" FontAttributes="Bold" FontSize="16" Text="{loc:Translate Common_Continue}" TextColor="White" LineBreakMode="WordWrap" MinimumHeightRequest="48" Padding="12,12" />
        </Border>

    </Grid>
</ContentPage>
